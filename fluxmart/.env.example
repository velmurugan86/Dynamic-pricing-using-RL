# Supabase project settings (Project Settings → API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Your DQN pricing model's two routes
# Route 1 (required): send product/demand state, get back a recommended price
VITE_DQN_PREDICT_URL=http://localhost:8000/api/predict
# Route 2 (required): report purchase outcomes for online learning
VITE_DQN_FEEDBACK_URL=http://localhost:8000/api/feedback
# Route 3 (optional): live training statistics
VITE_DQN_STATS_URL=http://localhost:8000/api/training-stats
